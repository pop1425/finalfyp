{
  "name": "voicesend-backend",
  "version": "1.0.0",
  "description": "VoiceSend payment API server",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:express --external:cors --external:dotenv --external:express-validator",
    "start": "node dist/index.js",
    "dev": "npx tsx watch src/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.0",
    "express": "^4.21.0",
    "express-validator": "^7.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.3.3"
  }
}
