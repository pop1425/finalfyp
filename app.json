{
  "expo": {
    "name": "VoiceSend",
    "slug": "App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app uses biometric authentication to secure your transactions.",
        "NSMicrophoneUsageDescription": "Allow VoiceSend to use the microphone for transaction commands.",
        "NSSpeechRecognitionUsageDescription": "Allow VoiceSend to use speech recognition to parse transaction commands."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.pop1425.App"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow VoiceSend to use the microphone for transaction commands.",
          "speechRecognitionPermission": "Allow VoiceSend to use speech recognition to parse transaction commands."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow VoiceSend to access contacts to find transaction recipients."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "This app uses biometric authentication to secure your transactions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50b18dd8-3dd4-4ce5-adeb-f7a02eb877b9"
      }
    },
    "owner": "pop1425"
  }
}
